{
  "framework": "nextjs",
  "functions": {
    "src/app/api/**/*.ts": { "maxDuration": 15 },
    "src/app/api/cron/enrich-ai/route.ts": { "maxDuration": 180 }
  },
  "crons": [
    { "path": "/api/cron/enrich-ai",          "schedule": "0 */3 * * *" },
    { "path": "/api/cron/publish",             "schedule": "0 21 * * *"  },
    { "path": "/api/cron/collect-incremental", "schedule": "0 0 * * *"   },
    { "path": "/api/cron/publish-blog",        "schedule": "0 */12 * * *" },
    { "path": "/api/cron/gsc-submit",          "schedule": "0 22 * * *"  },
    { "path": "/api/cron/gsc-blog-report",     "schedule": "30 22 * * *" },
    { "path": "/api/cron/gsc-blog-index-report", "schedule": "0 23 * * *" }
  ]
}
